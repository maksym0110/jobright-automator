{
  "manifest_version": 3,
  "name": "Jobright Bot + Resume Builder",
  "version": "2.0.0",
  "description": "One click: walks the Jobright feed, reads each job description from the company's own page, marks it applied, and generates a matched CV, cover letter and Excel report.",
  "permissions": ["tabs", "storage", "sidePanel", "debugger", "scripting", "downloads", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://jobright.ai/*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://jobright.ai/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Jobright Bot + Resume Builder" },
  "side_panel": { "default_path": "popup.html" },
  "options_page": "options.html"
}
