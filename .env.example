# Copy to .env and adjust.

# Jobright URL to open on start (the job feed / recommended jobs page).
JOBRIGHT_URL=https://jobright.ai/jobs/recommend

# true  = never click anything, just report what it WOULD do.
# false = live mode.
DRY_RUN=true

# Safety cap on Apply clicks per run. Start small.
MAX_APPLICATIONS_PER_RUN=2

# How many times to scroll/load more before giving up (0 = only what's visible).
MAX_SCROLL_ROUNDS=3

# Timeouts (ms)
NEW_TAB_TIMEOUT=15000
CONFIRMATION_TIMEOUT=15000

# What to do when a new tab does not appear after clicking Apply: "continue" | "stop"
ON_NEW_TAB_TIMEOUT=continue

# Cards labelled "APPLY NOW" (no autofill): "skip" (default, per spec) | "click"
APPLY_NOW_BEHAVIOR=skip

# Skip cards tagged "Reposted N hours ago": true | false
SKIP_REPOSTED=true

# For skipped (already-applied) cards, click the card's "not interested" button
# then "Already Applied" so Jobright removes them from the list: true | false
HIDE_APPLIED_JOBS=true

# Pause after "Did you apply?" appears before clicking Yes (ms, random in range)
CONFIRM_DELAY_MIN=1500
CONFIRM_DELAY_MAX=3500

# Pause between jobs (ms) — a little human pacing.
DELAY_BETWEEN_JOBS=1500

# Paths
BROWSER_PROFILE_DIR=./browser-profile
DB_PATH=./data/jobright.db

# Resume-builder Postgres (Supabase). Companies in its applications/interviews
# tables are merged into the local history before every run. Leave empty to
# use the local history only.
DATABASE_URL=
# Optional: only pull rows for this resume-builder user_id.
REMOTE_USER_ID=
REMOTE_SYNC_TIMEOUT=15000
