{
  "name": "jobright-bot",
  "version": "1.0.0",
  "description": "Jobright job-filtering & apply-tab automation bot",
  "scripts": {
    "start": "tsx src/index.ts",
    "dry": "cross-env DRY_RUN=true tsx src/index.ts",
    "login": "tsx src/index.ts --login",
    "inspect": "tsx src/index.ts --inspect",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "sync": "tsx src/index.ts --sync",
    "list": "tsx src/index.ts --list",
    "offline": "tsx src/index.ts --offline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maksym0110/jobright-automator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/maksym0110/jobright-automator/issues"
  },
  "homepage": "https://github.com/maksym0110/jobright-automator#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  },
  "private": true
}
